{
  "expo": {
    "name": "FreshLiv",
    "slug": "freshliv",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "gwalawala",
    "plugins": [
      "expo-router",
      ["expo-notifications", {"defaultChannel": "orders"}]
    ],
    "android": {"package": "com.gwalawala.app"},
    "ios": {"bundleIdentifier": "com.gwalawala.app", "infoPlist": {"LSApplicationQueriesSchemes": ["phonepe","tez","paytmmp","bhim","amazonpay","credpay","upi"]}},
    "experiments": {"typedRoutes": true}
  }
}
